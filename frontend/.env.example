# Backend base URL as seen by the browser (used by the API client).
# Defaults to a relative "/api/v1" which Next.js rewrites to the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend URL used by Next.js server-side rewrites. In Docker Compose this is
# set to http://backend:8000 automatically.
BACKEND_INTERNAL_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# API authentication (optional)
# ---------------------------------------------------------------------------
# The browser does NOT need an API key at build time and no master secret is
# embedded in the client bundle. The operator signs in through the /login page
# with one of the backend operator keys (AUTH_ADMIN_API_KEY or
# AUTH_READONLY_API_KEY, configured server-side). The backend then issues a
# short-lived, revocable session token that the UI sends on every request and
# WebSocket; logout revokes it. No NEXT_PUBLIC_* credential variable exists.

# ---------------------------------------------------------------------------
# Branding & version (Sprint 29 - Open Source Identity)
# ---------------------------------------------------------------------------
# Application branding
NEXT_PUBLIC_APP_NAME=OpenWrt AI Copilot
NEXT_PUBLIC_APP_TAGLINE=Provider-independent AI copilot for managing OpenWrt router fleets.
NEXT_PUBLIC_COMPANY_NAME=Necrodin
NEXT_PUBLIC_AUTHOR=The OpenWrt AI Copilot contributors
NEXT_PUBLIC_LICENSE=MIT

# Versioning — injected at build time by the CI / Docker build pipeline.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_FRONTEND_VERSION=0.1.0
NEXT_PUBLIC_GIT_COMMIT=
NEXT_PUBLIC_BUILD_DATE=
NEXT_PUBLIC_ENVIRONMENT=development

# Canonical site URL (used for Open Graph / Twitter metadata root).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Repository & community links
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/necrodin/openwrt-ai-copilot
NEXT_PUBLIC_DOCUMENTATION_URL=https://github.com/necrodin/openwrt-ai-copilot/tree/main/docs
NEXT_PUBLIC_ISSUES_URL=https://github.com/necrodin/openwrt-ai-copilot/issues/new/choose
NEXT_PUBLIC_RELEASES_URL=https://github.com/necrodin/openwrt-ai-copilot/releases
NEXT_PUBLIC_DISCUSSIONS_URL=https://github.com/necrodin/openwrt-ai-copilot/discussions
NEXT_PUBLIC_WIKI_URL=https://github.com/necrodin/openwrt-ai-copilot/wiki
NEXT_PUBLIC_ROADMAP_URL=https://github.com/necrodin/openwrt-ai-copilot/issues?q=is%3Aissue+is%3Aopen+label%3Aroadmap
NEXT_PUBLIC_CHANGELOG_URL=https://github.com/necrodin/openwrt-ai-copilot/blob/main/CHANGELOG.md

# Socials
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/necrodin/openwrt-ai-copilot
NEXT_PUBLIC_SOCIAL_OPENWRT=https://openwrt.org

# Donation targets (Support Development page).
# Leave empty to show a target as "Not configured". Only supply real links —
# the UI never invents or guesses donation addresses.
NEXT_PUBLIC_DONATE_GITHUB=
NEXT_PUBLIC_DONATE_BUYMEACOFFEE=
NEXT_PUBLIC_DONATE_KOFI=
NEXT_PUBLIC_DONATE_PAYPAL=
NEXT_PUBLIC_DONATE_AMAZON=
NEXT_PUBLIC_DONATE_BITCOIN=
NEXT_PUBLIC_DONATE_ETHEREUM=
NEXT_PUBLIC_DONATE_LIGHTNING=
