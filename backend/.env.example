# SQLite database file (relative paths resolve against the working directory)
DATABASE_URL=sqlite:///./data/openwrt_ai.db

# Comma-separated list is NOT supported; use a JSON array for list settings
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# --- API authentication ----------------------------------------------------
# Operator API keys for the /api/v1 REST routes and the dashboard WebSocket.
# These are static credentials used by scripts/CLI and exchanged once by the
# web UI (see below). Keys are never written to source, never logged, never
# returned by the API. Leave a key empty to disable that role.
#
# AUTH_ADMIN_API_KEY    — full access: reads + management/management jobs.
# AUTH_READONLY_API_KEY — read-only access: status, dashboard, providers, chat.
# When both are empty every protected request is rejected (fail closed).
# AUTH_ADMIN_API_KEY=
# AUTH_READONLY_API_KEY=
#
# Browser sessions issued by POST /auth/login expire after this many seconds
# and are revoked server-side on logout. Shorten for stricter environments.
# AUTH_SESSION_TTL=28800

# --- Live dashboard router ------------------------------------------------
# Leave ROUTER_DEVICE_HOST empty to use the built-in simulated demo source.
# ROUTER_DEVICE_TRANSPORT: "", "ssh", "local", or "simulated" ("" auto-selects:
# ssh when a host is set, otherwise simulated)
# ROUTER_DEVICE_HOST=192.168.1.1
# ROUTER_DEVICE_PORT=22
# ROUTER_USERNAME=root
# ROUTER_SSH_KEY=/home/user/.ssh/id_ed25519
# ROUTER_PASSWORD=
# Seconds between dashboard polls
# ROUTER_POLL_INTERVAL=5
