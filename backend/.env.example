# SQLite database file (relative paths resolve against the working directory)
DATABASE_URL=sqlite:///./data/openwrt_ai.db

# Comma-separated list is NOT supported; use a JSON array for list settings
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# --- API authentication ----------------------------------------------------
# Programmatic clients (scripts, CLI, curl) authenticate with
# Authorization: Bearer <key>. These static keys are never written to source,
# never logged, never returned by the API. Leave a key empty to disable that
# role.
#
# AUTH_ADMIN_API_KEY    — full access: reads + management/management jobs.
# AUTH_READONLY_API_KEY — read-only access: status, dashboard, providers, chat.
# When both are empty every protected request is rejected (fail closed).
# AUTH_ADMIN_API_KEY=
# AUTH_READONLY_API_KEY=
#
# Browser login. On the FIRST startup the web UI shows a one-time setup wizard
# that creates the initial administrator account (username + password + confirm
# password). The password is bcrypt-hashed and stored in the database; the
# plaintext is never persisted, logged, or returned. No browser/login
# credentials need to be set in the environment — setup is prompted in the
# browser.
#
# MIGRATION ONLY (existing installations): if you previously configured browser
# credentials via AUTH_ADMIN_USERNAME/PASSWORD below (and optionally the
# read-only pair), the FIRST boot that finds an empty users table stores a
# hashed copy of those credentials. Afterwards the stored accounts are
# authoritative and these fields are ignored. Leave them empty for a fresh
# installation and use the setup wizard instead.
#
# AUTH_ADMIN_USERNAME=
# AUTH_ADMIN_PASSWORD=
# AUTH_READONLY_USERNAME=
# AUTH_READONLY_PASSWORD=
#
# Browser sessions issued by POST /auth/login expire after this many seconds
# and are revoked server-side on logout. Shorten for stricter environments.
# AUTH_SESSION_TTL=28800

# --- Router credential encryption (at rest) --------------------------------
# Router passwords / private keys are stored in SQLite only as ciphertext.
# No configuration is required: on the first startup a cryptographically random
# vault key is generated and persisted owner-only (0600) as `vault.key` inside
# the application data directory (next to the database file); restarts reuse it
# automatically so existing ciphertext keeps decrypting.
#
# AUTH_VAULT_KEY optionally overrides the generated/derived key — set it when
# migrating a database that was encrypted with a specific key, or when you want
# keys managed entirely outside the data directory:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When AUTH_VAULT_KEY is unset, a non-placeholder SECRET_KEY is used as a
# derivation source (SHA-256) and the derived key is then persisted too; with
# neither configured the key is freshly generated. Existing plaintext databases
# are migrated automatically on first boot. If already-encrypted credentials
# exist but no key can be recovered, startup fails with a clear message.
# AUTH_VAULT_KEY=

# --- SSH host-key verification ----------------------------------------------
# The SSH client verifies host keys against a persisted known-hosts store
# (trust-on-first-use by default; a changed host key is rejected). Override the
# store location with OPENWRT_AI_KNOWN_HOSTS (default: ./data/known_hosts).
# OPENWRT_AI_KNOWN_HOSTS=./data/known_hosts

# --- Live dashboard router ------------------------------------------------
# Leave ROUTER_DEVICE_HOST empty to use the built-in simulated demo source.
# ROUTER_DEVICE_TRANSPORT: "", "ssh", "local", or "simulated" ("" auto-selects:
# ssh when a host is set, otherwise simulated)
# ROUTER_DEVICE_HOST=192.168.1.1
# ROUTER_DEVICE_PORT=22
# ROUTER_USERNAME=root
# ROUTER_SSH_KEY=/home/user/.ssh/id_ed25519
# ROUTER_PASSWORD=
# Seconds between dashboard polls
# ROUTER_POLL_INTERVAL=5
