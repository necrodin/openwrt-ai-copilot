# SQLite database file (relative paths resolve against the working directory)
DATABASE_URL=sqlite:///./data/openwrt_ai.db

# Comma-separated list is NOT supported; use a JSON array for list settings
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# --- Live dashboard router ------------------------------------------------
# Leave ROUTER_DEVICE_HOST empty to use the built-in simulated demo source.
# ROUTER_DEVICE_TRANSPORT: "", "ssh", "local", or "simulated" ("" auto-selects:
# ssh when a host is set, otherwise simulated)
# ROUTER_DEVICE_HOST=192.168.1.1
# ROUTER_DEVICE_PORT=22
# ROUTER_USERNAME=root
# ROUTER_SSH_KEY=/home/user/.ssh/id_ed25519
# ROUTER_PASSWORD=
# Seconds between dashboard polls
# ROUTER_POLL_INTERVAL=5
